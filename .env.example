# Copy to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql://user:password@host:5432/invoice_db
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-5.4-nano"
OPENAI_FALLBACK_MODEL="gpt-5.4-mini"
AWS_REGION=eu-north-1
S3_BUCKET_NAME=amzn-invoiceapp
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="InvoiceAPP"
ADMIN_EMAIL=admin@example.com
GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/gcp-credentials.json"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@example.com
SMTP_USE_TLS=true
